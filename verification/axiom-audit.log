def Erdos319Formal.Primitive : Finset ℕ → Prop :=
fun A => ∃ δ, Erdos319Formal.signedSum A δ = 0 ∧ ∀ C ⊆ A, Erdos319Formal.signedSum C δ = 0 → C = ∅ ∨ C = A
def Erdos319Formal.maxSize : ℕ → ℕ :=
fun N => (Finset.filter Erdos319Formal.Primitive (Finset.Icc 1 N).powerset).sup Finset.card
theorem Erdos319Formal.erdos_problem_319_limit : Filter.Tendsto (fun N => ↑(Erdos319Formal.maxSize N) / ↑N) Filter.atTop
  (nhds 1) :=
Erdos319Formal.erdos_problem_319
Erdos319Formal.erdos_problem_319_witnesses (ε : ℝ) :
  0 < ε →
    ∀ᶠ (N : ℕ) in Filter.atTop,
      ∃ A ⊆ Finset.Icc 1 N,
        ∃ δ,
          (∀ (n : ℕ), δ n = 1 ∨ δ n = -1) ∧
            ∑ n ∈ A, ↑(δ n) / ↑n = 0 ∧ (∀ C ⊆ A, C ≠ ∅ → C ≠ A → ∑ n ∈ C, ↑(δ n) / ↑n ≠ 0) ∧ (1 - ε) * ↑N ≤ ↑A.card
def Erdos319Submission.LiteralPrimitive : Finset ℕ → Prop :=
fun A =>
  ∃ δ, (∀ (n : ℕ), δ n = 1 ∨ δ n = -1) ∧ ∑ n ∈ A, ↑(δ n) / ↑n = 0 ∧ ∀ C ⊂ A, C.Nonempty → ∑ n ∈ C, ↑(δ n) / ↑n ≠ 0
Erdos319Submission.literal_maximum (N : ℕ) :
  IsGreatest {k | ∃ A ⊆ Finset.Icc 1 N, Erdos319Submission.LiteralPrimitive A ∧ A.card = k} (Erdos319Formal.maxSize N)
Erdos319Submission.original_problem_nonempty_witnesses (ε : ℝ) :
  0 < ε →
    ε < 1 →
      ∀ᶠ (N : ℕ) in Filter.atTop,
        ∃ A ⊆ Finset.Icc 1 N, A.Nonempty ∧ Erdos319Submission.LiteralPrimitive A ∧ (1 - ε) * ↑N ≤ ↑A.card
